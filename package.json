{
  "name": "multi-google-cal-desktopapp",
  "private": true,
  "version": "0.1.0",
  "description": "Your calendars, one place. A desktop calendar for multiple Google accounts.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:static": "cd src-tauri && exec ./target/debug/multi-calendar",
    "dev:static:prepare": "pnpm build:debug",
    "dev:static:fresh": "pnpm dev:static:prepare && pnpm dev:static",
    "build": "tsc -b && vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests *.ts *.js *.json index.html README.md src-tauri/tauri.conf.json src-tauri/capabilities/default.json",
    "format:check": "prettier --check src tests *.ts *.js *.json index.html README.md src-tauri/tauri.conf.json src-tauri/capabilities/default.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-store": "^2.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
